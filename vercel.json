{
  "version": 2,
  "builds": [
    {
      "src": "api/backend.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "static/**",
          "utils/**",
          "services/**",
          "routes/**",
          "models/**",
          "database/**"
        ]
      }
    },
    {
      "src": "api/frontend.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "templates/**",
          "static/**",
          "utils/**",
          "services/**",
          "routes/**",
          "models/**",
          "database/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/admin(/.*)?",
      "dest": "/api/backend.py"
    },
    {
      "src": "/auth(/.*)?",
      "dest": "/api/backend.py"
    },
    {
      "src": "/msasathik(/.*)?",
      "dest": "/api/backend.py"
    },
    {
      "src": "/ashiksathik(/.*)?",
      "dest": "/api/backend.py"
    },
    {
      "src": "/(.*)",
      "dest": "/api/frontend.py"
    }
  ]
}
